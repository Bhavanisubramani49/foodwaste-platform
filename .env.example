# ==============================================================================
# Food Waste Management Platform - Environment Configuration Template
# Copy this file to .env and update values for your environment.
# ==============================================================================

# Django Secret Key (generate a strong key for production)
SECRET_KEY=django-insecure-fw-waste-platform-dev-key-change-in-production

# Debug Mode (set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated list)
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Database Configuration (PostgreSQL by default)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=foodwaste_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432
