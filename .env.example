# ==========================================
# Django Application Configuration (.env.example)
# Copy this file to .env and fill in your values
# ==========================================

# Django Secret Key (generate a random string or let Django use dev fallback)
SECRET_KEY=

# Debug mode (True for development, False for production)
DEBUG=True

# Supabase PostgreSQL Database Settings
# Find these in your Supabase project dashboard -> Settings -> Database
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
